# ─── Supabase ────────────────────────────────────────────────────────────
# URL ของ Supabase project (เอาจาก dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Anon key — ใช้ใน normal client (login/register)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — power admin ⚠️ ห้าม commit / ห้ามใช้ใน frontend
# ใช้สำหรับ:
#   - auth.service.ts (rollback Supabase user เมื่อ register ล้มเหลว)
#   - prisma/seed.ts  (create admin user, PYG-132)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database (Prisma) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000

# ─── Admin Seed (PYG-132) ────────────────────────────────────────────────
# Account สำหรับ initial admin — ใช้ใน prisma/seed.ts
# รันด้วย: npx prisma db seed
ADMIN_EMAIL=admin@payung.local
ADMIN_PASSWORD=ChangeMe-Strong-Password-123!

// ไฟล์นี้คือไฟล์ที่จะสื่อว่า .env จริงๆต้องการอะไรบ้าง

# ─── Cron Jobs (PYG-159) ─────────────────────────────────────────────────
# Auto-delete admins past grace period — cron syntax, default: daily at midnight
# CRON_ADMIN_CLEANUP_SCHEDULE=0 0 * * *

# ─── Email / SMTP (PYG-96 / PYG-292 / PYG-293) ───────────────────────────
# ส่ง email ผ่าน nodemailer SMTP (KYC, admin, booking lifecycle)
# Gmail: ใช้ App Password (Settings → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-app-password
# Sender address — แสดงในช่อง From: ของอีเมล
EMAIL_FROM=Payung <noreply@payung.app>
# Base URL ของ FE (สำหรับสร้าง CTA link ในอีเมล) — default 'https://payung.app'
# FRONTEND_URL=http://localhost:5173
