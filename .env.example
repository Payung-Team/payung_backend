# ─── Supabase ────────────────────────────────────────────────────────────
# URL ของ Supabase project (เอาจาก dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Anon key — ใช้ใน normal client (login/register)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — power admin ⚠️ ห้าม commit / ห้ามใช้ใน frontend
# ใช้สำหรับ:
#   - auth.service.ts (rollback Supabase user เมื่อ register ล้มเหลว)
#   - prisma/seed.ts  (create admin user, PYG-132)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database (Prisma) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# Shadow DB for `prisma migrate dev` — see docker-compose.dev.yml
# Only required when creating a new migration locally (`migrate dev`, not `deploy`).
# Start the shadow container first: `docker compose -f docker-compose.dev.yml up -d`
SHADOW_DATABASE_URL=postgresql://shadow:shadow@localhost:5433/payung_shadow

# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000

# ─── Admin Seed (PYG-132) ────────────────────────────────────────────────
# Account สำหรับ initial admin — ใช้ใน prisma/seed.ts
# รันด้วย: npx prisma db seed
ADMIN_EMAIL=admin@payung.local
ADMIN_PASSWORD=ChangeMe-Strong-Password-123!

// ไฟล์นี้คือไฟล์ที่จะสื่อว่า .env จริงๆต้องการอะไรบ้าง

# ─── Cron Jobs (PYG-159) ─────────────────────────────────────────────────
# Auto-delete admins past grace period — cron syntax, default: daily at midnight
# CRON_ADMIN_CLEANUP_SCHEDULE=0 0 * * *

# ─── Payout worker (PYG-330 ก้อน B) ──────────────────────────────────────
# Hold window: จำนวนวันหลัง booking.completed_at ก่อนจะโอนเงินให้ caregiver
PAYOUT_HOLD_WINDOW_DAYS=7
# Platform fee rate: snapshot ลง payouts.fee_rate ทุก row (0.10 = 10%)
# ⚠️ เปลี่ยนค่านี้กระทบเฉพาะ payout ใบใหม่ — row เดิมยังใช้ rate ที่ snapshot ไว้
PAYOUT_PLATFORM_FEE_RATE=0.10
# Cutoff — booking.completed_at ก่อนวันนี้จะไม่สร้าง payout (กัน backfill test data)
# ⚠️ ต้องเป็น ISO string ที่มี timezone offset (จะเป็น UTC absolute หลัง parse)
PAYOUT_START_FROM=2026-07-18T00:00:00+07:00

# ─── PYG-331: state machine + retry + kill-switch ────────────────────────
# Max retries ก่อนย้ายไป status='failed'
PAYOUT_MAX_RETRIES=5
# Exponential backoff เป็นนาที (comma-list, ต้องยาว ≥ MAX_RETRIES-1)
# retry ครั้งที่ N ใช้ backoffs[N-1] เช่น 10,30,60,180,360 = 10m, 30m, 1h, 3h, 6h
PAYOUT_BACKOFF_MINUTES=10,30,60,180,360
# Reaper: row status='processing' updated_at เก่ากว่านี้ = ถือว่าค้าง → คืน scheduled
PAYOUT_STALE_PROCESSING_MINUTES=30
# Emergency stop — true = worker+reaper skip ทั้งรอบ ไม่ยิง Omise
# ⚠️ env-only ตามเจตนา — DB-backed toggle เป็นของ PYG-336 อย่าเพิ่มซ้อน
PAYOUT_KILLSWITCH_ENABLED=false

# ─── QR check-in/out (PYG-434 · การ์ดแม่ PYG-433) ────────────────────────
# ★★ ต้องตั้งค่านี้ก่อนขึ้น production มิฉะนั้นแอปจะไม่ยอมบูต ★★
# กุญแจลับที่ใช้ "เซ็น" QR ของทุก booking — ยาวอย่างน้อย 32 ตัวอักษร
#   - ห้าม commit ค่าจริงลง git และห้ามส่งไปฝั่ง frontend เด็ดขาด
#   - สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   - ⚠️ เปลี่ยนค่านี้ = QR ของ booking ทุกใบใช้ไม่ได้ทันที (ต้องเขียน token_hash ใหม่ทั้งตาราง)
#   - ตอน dev ถ้าไม่ตั้ง ระบบจะสุ่มให้ชั่วคราวพร้อมขึ้น warning (QR เปลี่ยนทุกครั้งที่ restart)
QR_TOKEN_SECRET=replace-me-with-a-32-char-or-longer-random-secret

# เปิดให้สแกน QR ได้ล่วงหน้ากี่นาทีก่อนเวลานัดเริ่มงาน
# ⚠️ ควรตั้งให้เท่ากับ EARLY_GRACE_MIN ของระบบเช็คอิน ไม่งั้นจะเกิดสถานการณ์
#    "เช็คอินได้แล้วแต่ QR ยังไม่เปิด" ซึ่งผู้ดูแลจะงงมาก
QR_VALID_FROM_OFFSET_MIN=60

# ยังสแกนได้อีกกี่นาทีหลังเวลานัดเลิกงาน (งานเลิกช้ากว่านัดเป็นเรื่องปกติ)
QR_VALID_UNTIL_GRACE_MIN=120

# true = 1 action สแกนได้ครั้งเดียว (สแกนซ้ำพร้อมกัน = ครั้งที่แพ้จะได้ผล DUPLICATE)
# false = ยอมให้สแกนซ้ำแล้วตอบ SUCCESS ไปเลย (ใช้เฉพาะตอนไล่บั๊ก ไม่ควรใช้จริง)
QR_SINGLE_USE_PER_ACTION=true

# ต้องเว้นกี่วินาที ระหว่างเช็คอินกับเช็คเอาท์ของงานใบเดียวกัน (PYG-435)
# ★ ค่านี้แก้ปัญหา "จ่อกล้องค้างไว้แล้วสแกนติดกันสองครั้ง" ซึ่งจะกลายเป็น
#   เปิดงานแล้วปิดงานทันทีใน 1 วินาที ถ้าไม่มีตัวกั้น
# ⚠️ ตั้ง 0 ได้ตอนรันเทส E2E (PYG-440) ที่ต้องเช็คอิน→เช็คเอาท์รวดเดียว
QR_MIN_SECONDS_BETWEEN_ACTIONS=60

# ─── Family Group · ลิงก์เข้าร่วมกลุ่ม (PYG-416 / PYG-428 · SCR-FG2-001) ───
# SCR-FG2-001 ตัดการส่งอีเมลผ่าน Resend ออกทั้งหมด → ไม่ต้องตั้ง RESEND_* สำหรับโมดูลนี้อีก

# อายุของลิงก์เข้าร่วม (ชั่วโมง) — 168 = 7 วัน
# ชื่อเดิม FAMILY_INVITE_TTL_HOURS ยังอ่านเป็น fallback ได้ แต่ควรย้ายมาใช้ชื่อใหม่
FAMILY_JOIN_LINK_TTL_HOURS=168

# จำนวนคนสูงสุดที่เข้าได้ด้วยลิงก์ 1 ใบ — ตั้ง 0 = ไม่จำกัด (ไม่แนะนำ)
FAMILY_JOIN_LINK_MAX_USES=10

# เพดานสมาชิก ACTIVE ต่อกลุ่ม
# SCR-FG2-001 เลื่อนค่านี้จาก optional มาเป็นบังคับ เพราะลิงก์ใช้ซ้ำได้แล้ว
# ตัวจำกัดจำนวนคนคือมาตรการควบคุมหลักที่เหลืออยู่แทนการผูกคำเชิญกับอีเมลรายคน
FAMILY_GROUP_MAX_MEMBERS=10

# โดเมนฝั่ง FE ที่เอาไปประกอบ URL ของลิงก์ → <base>/join?token=...
# ★ ไม่มีค่า default โดยตั้งใจ ถ้าไม่ตั้ง mutation สร้างลิงก์จะโยน JOIN_LINK_CONFIG_MISSING
#   ดีกว่าปล่อยให้สร้างลิงก์ที่ขึ้นต้นด้วย "undefined/join?token=" นอนอยู่ในดีบีถาวร
APP_PUBLIC_BASE_URL=https://payung.app
