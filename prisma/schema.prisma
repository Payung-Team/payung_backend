model Payment {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String                 @unique(map: "idx_payments_booking") @map("booking_id") @db.Uuid
  patientId      String                 @map("patient_id")
  caregiverId    String                 @map("caregiver_id")
  amount         Decimal                @db.Decimal(10, 2)
  capturedAmount Decimal?               @map("captured_amount") @db.Decimal(10, 2)
  refundedAmount Decimal                @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  currency       String                 @default("THB") @db.VarChar(3)
  omiseChargeId  String?                @map("omise_charge_id")
  omiseToken     String?                @map("omise_token")
  paymentMethod  String                 @default("credit_card") @map("payment_method") @db.VarChar(20)
  paymentStatus  PaymentStatus          @default(pending) @map("payment_status")
  failureCode    String?                @map("failure_code")
  failureMessage String?                @map("failure_message")
  metadata       Json                   @default("{}")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  statusHistory  PaymentStatusHistory[]
  booking        Booking                @relation(fields: [bookingId], references: [id], onUpdate: NoAction, map: "fk_payments_booking")
  caregiver      User                   @relation("CaregiverPayments", fields: [caregiverId], references: [id], onUpdate: NoAction, map: "fk_payments_caregiver")
  patient        User                   @relation("PatientPayments", fields: [patientId], references: [id], onUpdate: NoAction, map: "fk_payments_patient")

  @@index([patientId], map: "idx_payments_patient")
  @@index([paymentStatus], map: "idx_payments_status")
  // PYG-333: index รองรับ admin transactions list (default sort created_desc + date-range filter)
  @@index([createdAt], map: "idx_payments_created_at")
  @@map("payments")
}

/// PYG-277 — Audit trail ของการเปลี่ยน payment status (FSM)
/// ทุกครั้งที่ PaymentStateMachine.transition() ทำงาน → insert 1 แถวที่นี่
/// ใช้ตอบคำถาม "ทำไม payment ถึงเป็นสถานะนี้ ใครเปลี่ยน เปลี่ยนเมื่อไหร่"
model PaymentStatusHistory {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String         @map("payment_id") @db.Uuid
  fromStatus    PaymentStatus? @map("from_status")
  toStatus      PaymentStatus  @map("to_status")
  changedBy     String?        @map("changed_by")
  reason        String?
  metadata      Json?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  changedByUser User?          @relation("PaymentStatusChanges", fields: [changedBy], references: [id], onUpdate: NoAction, map: "fk_psh_changed_by")
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_psh_payment")

  @@index([paymentId], map: "idx_psh_payment")
  @@map("payment_status_history")
}

/// PYG-375: deterministic once-only execution for money commands (capture/refund/payout/transfer).
/// key is INSERTed before the Omise call; a PK collision → return stored `result` (no 2nd call).
/// Same key is also sent as the Omise-Idempotency-Key header (two layers). Cron prunes > 30 days.
model IdempotencyKey {
  key       String   @id
  action    String
  bookingId String?  @map("booking_id") @db.Uuid
  result    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("idempotency_keys")
}

