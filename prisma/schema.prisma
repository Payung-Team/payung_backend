generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Optional shadow DB for `prisma migrate dev` (does not affect `deploy`).
  // Points at the container in docker-compose.dev.yml. See
  // prisma/migrations/00000000000000_supabase_shadow_shim/migration.sql for
  // the Supabase-auth shim that lets old migrations replay against plain Postgres.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                                                      String                 @id @default(uuid())
  supabaseUid                                             String                 @unique @map("supabase_uid")
  email                                                   String                 @unique
  displayName                                             String?                @map("display_name")
  avatarUrl                                               String?                @map("avatar_url")
  isActive                                                Boolean                @default(true) @map("is_active")
  createdAt                                               DateTime               @default(now()) @map("created_at")
  updatedAt                                               DateTime               @updatedAt @map("updated_at")
  address                                                 String?                @map("address")
  bio                                                     String?                @map("bio")
  phone                                                   String?                @map("phone")
  role                                                    Int                    @default(1)
  emailPreferences                                        Boolean                @default(true) @map("email_preferences")
  invited_by                                              String?
  must_change_password                                    Boolean                @default(false)
  last_login_at                                           DateTime?              @db.Timestamptz(6)
  scheduled_delete_at                                     DateTime?              @db.Timestamptz(6)
  deletion_scheduled_by                                   String?
  is_deleted                                              Boolean                @default(false)
  deleted_at                                              DateTime?              @db.Timestamptz(6)
  is_suspended                                            Boolean                @default(false)
  subDistrict                                             String?                @map("sub_district")
  district                                                String?                @map("district")
  province                                                String?                @map("province")
  postalCode                                              String?                @map("postal_code")
  admin_audit_logs_admin_audit_logs_admin_idTousers       admin_audit_logs[]     @relation("admin_audit_logs_admin_idTousers")
  admin_audit_logs_admin_audit_logs_target_user_idTousers admin_audit_logs[]     @relation("admin_audit_logs_target_user_idTousers")
  bookings                                                Booking[]
  careRecipients                                          CareRecipient[]
  caregiver_edit_logs                                     caregiver_edit_logs[]
  caregiver                                               Caregiver?
  field_locks_field_locks_locked_byTousers                field_locks[]          @relation("field_locks_locked_byTousers")
  field_locks_field_locks_unlocked_byTousers              field_locks[]          @relation("field_locks_unlocked_byTousers")
  documents                                               KycDocument[]
  kycReviews                                              KycReview[]
  notifications                                           Notification[]
  paymentStatusChanges                                    PaymentStatusHistory[] @relation("PaymentStatusChanges")
  caregiverPayments                                       Payment[]              @relation("CaregiverPayments")
  patientPayments                                         Payment[]              @relation("PatientPayments")
  patientReviews                                          Review[]
  savedCaregivers                                         SavedCaregiver[]
  users_users_deletion_scheduled_byTousers                User?                  @relation("users_deletion_scheduled_byTousers", fields: [deletion_scheduled_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_users_users_deletion_scheduled_byTousers          User[]                 @relation("users_deletion_scheduled_byTousers")
  users_users_invited_byTousers                           User?                  @relation("users_invited_byTousers", fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_users_users_invited_byTousers                     User[]                 @relation("users_invited_byTousers")

  @@index([is_deleted], map: "idx_users_is_deleted")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Caregiver {
  id                  String                     @id @default(uuid())
  userId              String                     @unique @map("user_id")
  fullName            String?                    @map("full_name")
  idCardNumber        String?                    @map("id_card_number")
  phone               String?
  skills              String[]
  experienceYears     Int?                       @map("experience_years")
  hourlyRate          Float?                     @map("hourly_rate")
  bio                 String?
  kycStatus           String                     @default("none") @map("kyc_status")
  kycSubmittedAt      DateTime?                  @map("kyc_submitted_at")
  isSearchable        Boolean                    @default(false) @map("is_searchable")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  kycVerifiedAt       DateTime?                  @map("kyc_verified_at")
  resubmitCount       Int                        @default(0) @map("resubmit_count")
  caregiverNumber     String?                    @unique @map("caregiver_number")
  gender              String?
  dateOfBirth         DateTime?                  @map("date_of_birth")
  address             String?
  kycRejectedAt       DateTime?                  @map("kyc_rejected_at")
  kycRejectionReason  String?                    @map("kyc_rejection_reason")
  rejection_reasons   Json?
  serviceAreaProvince String?                    @map("service_area_province") @db.VarChar
  serviceAreaDistrict String?                    @map("service_area_district") @db.VarChar
  languages           String[]                   @default([])
  averageRating       Float?                     @map("average_rating")
  reviewCount         Int                        @default(0) @map("review_count")
  bookings            Booking[]
  availability        CaregiverAvailability[]
  caregiver_edit_logs caregiver_edit_logs[]
  jobTypes            CaregiverJobType[]
  serviceLocations    CaregiverServiceLocation[]
  user                User                       @relation(fields: [userId], references: [id])
  documents           KycDocument[]
  kycReviews          KycReview[]
  patientReviews      Review[]
  payoutAccount       CaregiverPayoutAccount?
  payouts             Payout[]
  savedByPatients     SavedCaregiver[]

  @@index([serviceAreaProvince, serviceAreaDistrict], map: "idx_caregivers_service_area")
  @@map("caregivers")
}

/// PYG-306 — Payout bank account 1:1 กับ Caregiver (foundation ของ Auto-Payout epic PYG-329)
/// account_number_enc = ciphertext เข้ารหัสที่ app layer; แสดงผลใช้ account_number_last4 เท่านั้น
/// omise_recipient_id + recipient_status จะถูกกรอกโดย webhook PYG-304 (ยังไม่ implement)
model CaregiverPayoutAccount {
  id                 String    @id @default(uuid())
  caregiverId        String    @unique @map("caregiver_id")
  bankCode           String    @map("bank_code")
  accountName        String    @map("account_name")
  accountNumberEnc   String    @map("account_number_enc")
  accountNumberLast4 String    @map("account_number_last4")
  omiseRecipientId   String?   @map("omise_recipient_id")
  recipientStatus    String    @default("unverified") @map("recipient_status")
  status             String    @default("pending")
  verifiedAt         DateTime? @map("verified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@map("caregiver_payout_accounts")
}

/// PYG-330 — Payout record 1:1 กับ Booking (worker + Omise Transfer จะทำในก้อน B)
/// - booking_id @unique = DB-level idempotency (1 booking = 1 payout) ไม่พึ่งแค่โค้ด
/// - onDelete Restrict ทั้ง 2 FK — ห้าม cascade ลบ record การเงิน
/// - timestamptz ทุกช่อง — worker query "scheduled_at <= now()" ต้อง tz-safe (ไทย UTC+7)
/// - index (status, scheduled_at) รองรับ worker query หลัก
///
/// PYG-330 (ก้อน A2) — fee snapshot:
///   gross_amount = payments.amount ของ booking นั้น
///   fee_rate     = config PAYOUT_PLATFORM_FEE_RATE (default 0.10) — snapshot ลง row เสมอ
///                  ห้าม default ระดับ DB / ห้ามคำนวณจาก env ตอน query (นโยบายเปลี่ยน = ประวัติเพี้ยน)
///   platform_fee = round(gross_amount * fee_rate, 2) HALF_UP
///   amount       = gross_amount - platform_fee  ← ต้องได้จาก "ลบ" เท่านั้น
///                  (ห้าม gross * (1 - rate) แยก — ปัดเศษแล้ว sum ไม่ตรง)
///
/// ⚠️ DB มี CHECK constraint `payouts_amount_split_check` (Prisma ไม่ support declare)
///    บังคับ: gross_amount = platform_fee + amount
///        AND platform_fee >= 0
///        AND amount >= 0
///        AND fee_rate >= 0
///    → โค้ดคำนวณผิด = INSERT ถูก reject ทันที (ป้องกันเงินหายทีละสตางค์)
model Payout {
  id              String    @id @default(uuid())
  bookingId       String    @unique @map("booking_id") @db.Uuid
  caregiverId     String    @map("caregiver_id")
  recipientId     String?   @map("recipient_id")
  grossAmount     Decimal   @map("gross_amount") @db.Decimal(10, 2)
  feeRate         Decimal   @map("fee_rate") @db.Decimal(5, 4)
  platformFee     Decimal   @map("platform_fee") @db.Decimal(10, 2)
  amount          Decimal   @db.Decimal(10, 2)
  status          String    @default("scheduled")
  scheduledAt     DateTime  @map("scheduled_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  omiseTransferId String?   @map("omise_transfer_id")
  retryCount      Int       @default(0) @map("retry_count")
  // PYG-331 (ก้อน A) — next_retry_at ใช้กับ exponential backoff ในก้อน B
  //   worker query จะเปลี่ยนเป็น: status='scheduled' AND scheduled_at <= now()
  //                                AND (next_retry_at IS NULL OR next_retry_at <= now())
  //   nullable — payout ที่ยังไม่เคย fail ไม่มีค่านี้ (worker เห็นเป็น "พร้อมยิงเลย")
  nextRetryAt     DateTime? @map("next_retry_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking       Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  caregiver     Caregiver             @relation(fields: [caregiverId], references: [id], onDelete: Restrict)
  statusHistory PayoutStatusHistory[]

  @@index([status, scheduledAt])
  // PYG-333: index รองรับ admin transactions list (default sort created_desc + date-range filter)
  @@index([createdAt], map: "idx_payouts_created_at")
  @@map("payouts")
}

/// PYG-331 (ก้อน A) — audit log ทุก transition ของ payout
/// mirror pattern ของ payment_status_history (PaymentStateMachine.runTransition() จะเขียนที่นี่ในก้อน B)
///
/// - fromStatus nullable → transition แรกตอนสร้าง payout (from = null)
/// - changedBy nullable → null = system (auto-retry worker); userId = admin action (336/337)
/// - onDelete Cascade ต่างจาก payouts FK (Restrict) เพราะ history เป็น log ลูกของ payout
///   ถ้าลบ payout log ควรหายตาม ไม่ใช่ block
/// - index (payout_id, created_at) → timeline query เรียงเวลา (337 export/reporting)
/// - status ยังเป็น text อิสระ (ไม่มี enum) — validate ใน state machine ของก้อน B
model PayoutStatusHistory {
  id         String   @id @default(uuid())
  payoutId   String   @map("payout_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedBy  String?  @map("changed_by")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId, createdAt])
  @@map("payout_status_history")
}

/// Audit trail ของ dispute — mirror payout_status_history
/// backend-only: RLS off, ไม่มี grant (ดู migration.sql)
model DisputeAuditLog {
  id         String   @id @default(uuid())
  bookingId  String   @map("booking_id") @db.Uuid
  action     String // dispute_filed | evidence_added | status_changed | resolved
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  actorId    String?  @map("actor_id") // null = system
  actorRole  String?  @map("actor_role") // patient | caregiver | admin
  note       String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("dispute_audit_logs")
}

/// หลักฐานของ dispute — เก็บ metadata + url, ไฟล์จริงอยู่ Supabase Storage (แบบ kyc_documents)
/// backend-only: RLS off, ไม่มี grant
model DisputeEvidence {
  id           String   @id @default(uuid())
  bookingId    String   @map("booking_id") @db.Uuid
  uploadedBy   String   @map("uploaded_by") // user id
  uploaderRole String   @map("uploader_role") // patient | caregiver | admin
  fileUrl      String   @map("file_url")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("dispute_evidence")
}

model CaregiverJobType {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiverId String    @map("caregiver_id")
  jobType     job_type  @map("job_type")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([caregiverId, jobType])
  @@index([jobType], map: "idx_caregiver_job_types_type")
  @@index([caregiverId], map: "idx_caregiver_job_types_caregiver")
  @@map("caregiver_job_types")
}

model CaregiverServiceLocation {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiverId     String           @map("caregiver_id")
  serviceLocation service_location @map("service_location")
  caregiver       Caregiver        @relation(fields: [caregiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([caregiverId, serviceLocation])
  @@index([serviceLocation], map: "idx_caregiver_service_locations_type")
  @@index([caregiverId], map: "idx_caregiver_service_locations_caregiver")
  @@index([caregiverId], map: "idx_csl_caregiver_id")
  @@map("caregiver_service_locations")
}

model CaregiverAvailability {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiverId String    @map("caregiver_id")
  dayOfWeek   Int       @map("day_of_week") @db.SmallInt
  timeSlot    time_slot @map("time_slot")
  isActive    Boolean   @default(true) @map("is_active")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([caregiverId, dayOfWeek, timeSlot])
  @@index([caregiverId], map: "idx_caregiver_availability_caregiver")
  @@map("caregiver_availability")
}

model Review {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String    @unique @map("booking_id") @db.Uuid
  patientId   String    @map("patient_id")
  caregiverId String    @map("caregiver_id")
  rating      Int
  comment     String?
  isAnonymous Boolean   @default(false) @map("is_anonymous")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  isVisible   Boolean   @default(true) @map("is_visible")
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient     User      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([caregiverId], map: "idx_reviews_caregiver")
  @@index([patientId], map: "idx_reviews_patient")
  @@map("reviews")
}

model Booking {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId                String            @map("patient_id")
  caregiverId              String?           @map("caregiver_id")
  careRecipientId          String?           @map("care_recipient_id") @db.Uuid
  serviceLocations         String[]          @map("service_locations")
  serviceType              String            @map("service_type")
  timeSlot                 String            @map("time_slot")
  startTime                DateTime          @map("start_time") @db.Time(6)
  durationHours            Decimal           @map("duration_hours") @db.Decimal
  locationAddress          String            @map("location_address")
  locationLat              Decimal?          @map("location_lat") @db.Decimal(10, 7)
  locationLng              Decimal?          @map("location_lng") @db.Decimal(10, 7)
  status                   String            @default("unmatched")
  rejectionReason          String?           @map("rejection_reason")
  estimatedCost            Decimal?          @map("estimated_cost") @db.Decimal(10, 2)
  platformFee              Decimal?          @map("platform_fee") @db.Decimal(10, 2)
  bookingDate              DateTime          @map("booking_date") @db.Date
  dayOfContactName         String?           @map("day_of_contact_name")
  dayOfContactPhone        String?           @map("day_of_contact_phone")
  dayOfContactRelationship String?           @map("day_of_contact_relationship")
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  confirmedAt              DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  tasks                    String[]          @default([]) @map("tasks")
  acceptedAt               DateTime?         @map("accepted_at") @db.Timestamptz(6)
  notes                    String?           @map("notes")
  disputeStatus            String            @default("none") @map("dispute_status") @db.VarChar(20)
  disputeReason            String?           @map("dispute_reason")
  disputeResolvedAt        DateTime?         @map("dispute_resolved_at") @db.Timestamptz(6)
  // PYG-316: when the dispute was filed (set on flag) — powers SLA calc, date filters & SLA sort
  disputeFiledAt           DateTime?         @map("dispute_filed_at") @db.Timestamptz(6)
  // PYG-316: who filed the dispute — 'customer' | 'caregiver' (only patients can file today)
  disputeFiledBy           String?           @map("dispute_filed_by") @db.VarChar(20)
  patientName              String?           @map("patient_name")
  completedAt              DateTime?         @map("completed_at") @db.Timestamptz(6)
  booking_tasks            booking_tasks[]
  careRecipient            CareRecipient?    @relation(fields: [careRecipientId], references: [id], onUpdate: NoAction)
  caregiver                Caregiver?        @relation(fields: [caregiverId], references: [id])
  patient                  User              @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment                  Payment?
  payout                   Payout?
  review                   Review?
  disputeAuditLogs         DisputeAuditLog[]
  disputeEvidence          DisputeEvidence[]

  @@index([caregiverId], map: "idx_bookings_caregiver")
  @@index([bookingDate], map: "idx_bookings_date")
  @@index([patientId], map: "idx_bookings_patient")
  @@index([status], map: "idx_bookings_status")
  @@index([disputeStatus], map: "idx_bookings_dispute_status")
  // PYG-316: composite index for the admin dispute queue — filter by status + sort by SLA (filedAt)
  @@index([disputeStatus, disputeFiledAt], map: "idx_bookings_dispute_queue")
  @@map("bookings")
}

model CareRecipient {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId               String          @map("patient_id")
  name                    String          @db.VarChar(255)
  nickname                String?         @db.VarChar(100)
  date_of_birth           DateTime?       @db.Date
  gender                  gender_enum?
  weight_kg               Decimal?        @db.Decimal(5, 2)
  height_cm               Decimal?        @db.Decimal(5, 2)
  mobility_level          mobility_level?
  medical_conditions      String[]
  current_medications     String?
  allergies               String?
  blood_type              String?         @db.VarChar(5)
  address_line            String?
  province                String?         @db.VarChar(100)
  district                String?         @db.VarChar(100)
  lat                     Decimal?        @db.Decimal(10, 7)
  lng                     Decimal?        @db.Decimal(10, 7)
  emergency_contact_name  String?
  emergency_contact_phone String?
  emergency_contact_rel   String?
  preferred_hospital      String?
  is_self                 Boolean         @default(false)
  created_at              DateTime        @default(now()) @db.Timestamptz(6)
  updated_at              DateTime        @default(now()) @db.Timestamptz(6)
  bookings                Booking[]
  patient                 User            @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patientId], map: "idx_care_recipients_patient")
  @@map("care_recipients")
}

model SavedCaregiver {
  patientId   String    @map("patient_id")
  caregiverId String    @map("caregiver_id")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  saved_at    DateTime  @default(now()) @db.Timestamptz(6)
  id          String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient     User      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([patientId, caregiverId])
  @@unique([patientId, caregiverId])
  @@index([patientId], map: "idx_saved_caregivers_patient")
  @@map("saved_caregivers")
}

model KycDocument {
  id           String     @id @default(uuid())
  caregiverId  String?    @map("caregiver_id")
  documentType String     @map("doc_type")
  fileUrl      String     @map("file_url")
  fileName     String     @map("file_name")
  fileSize     Int        @map("file_size")
  mimeType     String     @map("mime_type")
  uploadedAt   DateTime   @default(now()) @map("uploaded_at")
  userId       String     @map("user_id")
  caregiver    Caregiver? @relation(fields: [caregiverId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@map("kyc_documents")
}

model KycReview {
  id          String    @id @default(uuid())
  caregiverId String    @map("caregiver_id")
  reviewerId  String    @map("reviewer_id")
  action      String
  reason      String?
  reviewedAt  DateTime  @default(now()) @map("reviewed_at")
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id])
  reviewer    User      @relation(fields: [reviewerId], references: [id])

  @@map("kyc_reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model field_locks {
  id                                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type                          String
  entity_id                            String
  field_name                           String
  locked_by                            String
  locked_at                            DateTime  @default(now()) @db.Timestamptz(6)
  unlocked_at                          DateTime? @db.Timestamptz(6)
  unlocked_by                          String?
  users_field_locks_locked_byTousers   User      @relation("field_locks_locked_byTousers", fields: [locked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_field_locks_unlocked_byTousers User?     @relation("field_locks_unlocked_byTousers", fields: [unlocked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([entity_type, entity_id, field_name])
  @@index([locked_by], map: "idx_field_locks_locked_by")
}

model admin_audit_logs {
  id                                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id                                     String
  action                                       String
  target_user_id                               String?
  details                                      Json?
  created_at                                   DateTime @default(now())
  users_admin_audit_logs_admin_idTousers       User     @relation("admin_audit_logs_admin_idTousers", fields: [admin_id], references: [id])
  users_admin_audit_logs_target_user_idTousers User?    @relation("admin_audit_logs_target_user_idTousers", fields: [target_user_id], references: [id])
}

model caregiver_edit_logs {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caregiver_id  String
  edited_by     String
  action        String
  field_changes Json?
  created_at    DateTime  @default(now())
  caregivers    Caregiver @relation(fields: [caregiver_id], references: [id])
  users         User      @relation(fields: [edited_by], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model booking_tasks {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id   String   @db.Uuid
  description  String
  is_suggested Boolean  @default(false)
  is_custom    Boolean  @default(false)
  time_note    String?
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  bookings     Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id], map: "idx_booking_tasks_booking")
}

model Payment {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String                 @unique(map: "idx_payments_booking") @map("booking_id") @db.Uuid
  patientId      String                 @map("patient_id")
  caregiverId    String                 @map("caregiver_id")
  amount         Decimal                @db.Decimal(10, 2)
  capturedAmount Decimal?               @map("captured_amount") @db.Decimal(10, 2)
  refundedAmount Decimal                @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  currency       String                 @default("THB") @db.VarChar(3)
  omiseChargeId  String?                @map("omise_charge_id")
  omiseToken     String?                @map("omise_token")
  paymentMethod  String                 @default("credit_card") @map("payment_method") @db.VarChar(20)
  paymentStatus  PaymentStatus          @default(pending) @map("payment_status")
  failureCode    String?                @map("failure_code")
  failureMessage String?                @map("failure_message")
  metadata       Json                   @default("{}")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  statusHistory  PaymentStatusHistory[]
  booking        Booking                @relation(fields: [bookingId], references: [id], onUpdate: NoAction, map: "fk_payments_booking")
  caregiver      User                   @relation("CaregiverPayments", fields: [caregiverId], references: [id], onUpdate: NoAction, map: "fk_payments_caregiver")
  patient        User                   @relation("PatientPayments", fields: [patientId], references: [id], onUpdate: NoAction, map: "fk_payments_patient")

  @@index([patientId], map: "idx_payments_patient")
  @@index([paymentStatus], map: "idx_payments_status")
  // PYG-333: index รองรับ admin transactions list (default sort created_desc + date-range filter)
  @@index([createdAt], map: "idx_payments_created_at")
  @@map("payments")
}

/// PYG-277 — Audit trail ของการเปลี่ยน payment status (FSM)
/// ทุกครั้งที่ PaymentStateMachine.transition() ทำงาน → insert 1 แถวที่นี่
/// ใช้ตอบคำถาม "ทำไม payment ถึงเป็นสถานะนี้ ใครเปลี่ยน เปลี่ยนเมื่อไหร่"
model PaymentStatusHistory {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String         @map("payment_id") @db.Uuid
  fromStatus    PaymentStatus? @map("from_status")
  toStatus      PaymentStatus  @map("to_status")
  changedBy     String?        @map("changed_by")
  reason        String?
  metadata      Json?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  changedByUser User?          @relation("PaymentStatusChanges", fields: [changedBy], references: [id], onUpdate: NoAction, map: "fk_psh_changed_by")
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_psh_payment")

  @@index([paymentId], map: "idx_psh_payment")
  @@map("payment_status_history")
}

/// PYG-375: deterministic once-only execution for money commands (capture/refund/payout/transfer).
/// key is INSERTed before the Omise call; a PK collision → return stored `result` (no 2nd call).
/// Same key is also sent as the Omise-Idempotency-Key header (two layers). Cron prunes > 30 days.
model IdempotencyKey {
  key       String   @id
  action    String
  bookingId String?  @map("booking_id") @db.Uuid
  result    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("idempotency_keys")
}

