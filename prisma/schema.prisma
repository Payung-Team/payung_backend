// PYG-411 — Family Group (Epic PYG-381)
// migration: prisma/migrations/20260824000000_family_group_management
//
// ★ CHECK constraint และ partial index ทุกอันอยู่ในไฟล์ SQL เท่านั้น
//   เพราะ Prisma เขียนสองอย่างนี้ไม่ได้ → `db pull` ก็มองไม่เห็น จึงไม่ทำให้เกิด diff
// ═══════════════════════════════════════════════════════════════════════════

/// กลุ่มครอบครัวหนึ่งกลุ่ม
///
/// ★ ไม่มีฟิลด์ ownerId โดยตั้งใจ — "เจ้าของกลุ่ม" เก็บที่ FamilyGroupMember.role = 'OWNER'
///   ที่เดียว ถ้าเก็บซ้ำสองที่ พอ transferOwnership อัปเดตไม่ครบจะได้กลุ่มที่เจ้าของเพี้ยนแบบเงียบ ๆ
///   ดีบีบังคับ "OWNER ที่ ACTIVE ได้กลุ่มละคนเดียว" ด้วย partial unique index ในไฟล์ SQL
model FamilyGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// ดีบีมี CHECK: 1–80 ตัวอักษรหลัง trim (AC "rename empty or >80 chars → validation")
  name      String
  /// คนสร้างกลุ่ม = ประวัติ ไม่ใช่ "เจ้าของปัจจุบัน" (โอนเจ้าของได้ แต่คนสร้างเปลี่ยนไม่ได้)
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  creator        User?                 @relation(fields: [createdBy], references: [id])
  members        FamilyGroupMember[]
  invites        FamilyGroupInvite[]
  activity       FamilyGroupActivity[]
  careRecipients CareRecipient[]
  bookings       Booking[]

  @@map("family_groups")
}

/// ใครอยู่กลุ่มไหน บทบาทอะไร สถานะอะไร
model FamilyGroupMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  userId    String    @map("user_id")
  /// 'OWNER' | 'MEMBER' — text + CHECK ในดีบี ไม่ใช่ PG enum (กติกาของการ์ด)
  role      String    @default("MEMBER")
  /// 'ACTIVE' | 'REMOVED' | 'LEFT'
  /// ★ ไม่ลบแถวทิ้งตอนออก/โดนเตะ เพราะ activity feed ต้องอ้างย้อนหลังได้ว่าใครเคยอยู่
  /// PYG-412: ทุกการเช็คสิทธิ์ต้องกรอง status = 'ACTIVE' เสมอ
  status    String    @default("ACTIVE")
  /// NULL = คนสร้างกลุ่มเอง ไม่มีใครเชิญ
  invitedBy String?   @map("invited_by")
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  group   FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User        @relation("FamilyGroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter User?       @relation("FamilyGroupMemberInvitedBy", fields: [invitedBy], references: [id])

  /// คนเดียวมีได้แถวเดียวต่อกลุ่มไม่ว่าสถานะอะไร → คนที่เคยออกแล้วกลับเข้ามา
  /// คือ UPDATE status กลับเป็น ACTIVE ไม่ใช่ INSERT แถวที่สอง (ช่วยให้ PYG-417 idempotent)
  @@unique([groupId, userId])
  @@index([userId])
  /// คิวรี่ที่ FamilyGroupGuard (PYG-412) เรียกทุก request
  @@index([groupId, status])
  // partial unique "family_group_members_one_active_owner_key"
  // (WHERE role='OWNER' AND status='ACTIVE') อยู่ในไฟล์ SQL — Prisma เขียนไม่ได้
  @@map("family_group_members")
}

/// คำเชิญทางอีเมล (FG-2 / PYG-416, PYG-417)
model FamilyGroupInvite {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  /// เทียบแบบ case-insensitive ผ่าน index บน lower(email) ในไฟล์ SQL
  email     String
  /// ★ sha256(token) เป็น hex 64 ตัว — ห้ามเก็บ token ดิบ (โชว์ครั้งเดียวตอนสร้างลิงก์)
  ///   ดีบีมี CHECK char_length = 64 กันเผลอเก็บ token ดิบลงมา
  tokenHash String @unique @map("token_hash")
  /// 'PENDING' | 'ACCEPTED' | 'REVOKED' | 'EXPIRED'
  status    String @default("PENDING")

  invitedBy  String?   @map("invited_by")
  acceptedBy String?   @map("accepted_by")
  /// now() + FAMILY_INVITE_TTL_HOURS (168 ชม.) — คำนวณฝั่ง app เพราะ TTL เป็น config (PYG-428)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  group    FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter  User?       @relation("FamilyGroupInviteInvitedBy", fields: [invitedBy], references: [id])
  acceptor User?       @relation("FamilyGroupInviteAcceptedBy", fields: [acceptedBy], references: [id])

  // acceptInvite(token) หา invite จาก sha256(token) — unique อยู่ที่ฟิลด์ tokenHash ด้านบน
  @@index([groupId, status])
  // partial unique "family_group_invites_pending_group_email_key"
  // บน (group_id, lower(email)) WHERE status='PENDING' อยู่ในไฟล์ SQL — Prisma เขียนไม่ได้
  @@map("family_group_invites")
}

/// ฟีดกิจกรรมของกลุ่ม แบบ append-only (FG-3 / PYG-421)
/// ทุกแถวต้องเขียนใน transaction เดียวกับการเปลี่ยนแปลงจริง (AC A5) ห้าม fire-and-forget
model FamilyGroupActivity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  /// ★ ลบ user แล้วเป็น NULL ไม่ใช่ลบแถวตาม — ฟีดคือหลักฐาน ห้ามลบบัญชีแล้วลบร่องรอยตัวเองได้
  actorId    String?  @map("actor_id")
  /// ค่าที่อนุญาตดูได้จาก CHECK "family_group_activity_action_check" ในไฟล์ SQL
  /// (เช่น GROUP_CREATED, MEMBER_JOINED, BOOKING_ON_BEHALF)
  action     String
  /// 'GROUP' | 'MEMBER' | 'INVITE' | 'RECIPIENT' | 'BOOKING'
  targetType String?  @map("target_type")
  /// polymorphic จึง "ไม่มี FK" และเป็น TEXT เพราะเป้าหมายปนกันทั้ง UUID และ TEXT
  targetId   String?  @map("target_id")
  /// รายละเอียดที่ไม่คุ้มทำเป็นคอลัมน์ เช่น {"oldName":"บ้านยาย","newName":"บ้านย่า"}
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User?       @relation(fields: [actorId], references: [id])

  /// keyset pagination ของ PYG-421 (created_at DESC)
  /// ★ ต้องมี id ต่อท้าย เพราะ activity ที่เขียนใน transaction เดียวกันได้ created_at เท่ากันเป๊ะ
  ///   cursor ที่ดูแค่ created_at จะข้ามแถวหายหรือวนซ้ำ → cursor ต้องเป็นคู่ (createdAt, id)
  @@index([groupId, createdAt(sort: Desc), id(sort: Desc)], map: "family_group_activity_group_id_created_at_idx")
  @@map("family_group_activity")
}

