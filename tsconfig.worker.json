{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": ".worker-build",
    "declaration": false,
    "incremental": false,
    "types": ["node", "express", "multer", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "src/main.ts"
  ]
}
